# BLACKSITE: Academy — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_64_character_hex_string

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change_me_to_a_fernet_key

# ── App ───────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./blacksite.db
STORAGE_PATH=./storage
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# First-run admin password (hashed on first startup, then ignored)
DEFAULT_ADMIN_PASSWORD=changeme_immediately

# JWT token lifetimes (seconds)
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# ── Whisper (auto-subtitle generation) ───────────────────────────────────────
# tiny | base | small | medium | large  (larger = more accurate, slower)
WHISPER_MODEL=base

# ── File size limits ─────────────────────────────────────────────────────────
MAX_VIDEO_SIZE_MB=10240
MAX_DOCUMENT_SIZE_MB=500

# ── Rate limiting ─────────────────────────────────────────────────────────────
AUTH_RATE_LIMIT=10/minute
AI_RATE_LIMIT=20/minute
